{
  "name": "dank-map",
  "version": "0.2.0",
  "description": "A map function that can map over almost anything.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wankdanker/node-dank-map.git"
  },
  "keywords": [
    "map",
    "attribute",
    "key",
    "index",
    "array"
  ],
  "author": "Dan VerWeire",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.49.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^3.0.4"
  }
}
